---
import "@fontsource-variable/onest";
import "@fontsource/instrument-serif";

interface Props {
  title: string;
  singlePage?: boolean;
}

const { title, singlePage = false } = Astro.props;
const routeName = Astro.url.pathname;

import Nav from "../components/Nav.astro";
import Header from "../components/Header.astro";
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-era="2021-2024">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Joaquin Ferreiros — Full-Stack developer portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={['flex', singlePage ? 'flex-col' : 'items-center justify-center']}>
    {singlePage ? (
      <slot />
    ) : (
      <div class="container max-w-7xl">
        <Header />
        <main class="flex justify-center items-start h-[90vh] overflow-y-scroll">
          <slot />
        </main>
        <footer>
          <Nav currentPath={routeName}/>
        </footer>
      </div>
    )}
    <script>
      import '../scripts/era-observer.ts';
    </script>
  </body>
</html>
