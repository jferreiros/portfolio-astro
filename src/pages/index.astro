---
import Layout from '../layouts/Layout.astro';
import IdentityOrb from '../components/IdentityOrb.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import WorkSection from '../components/WorkSection.astro';

const engineerProjects = [
  {
    name: 'Vivla',
    tagline: 'Co-ownership of vacation homes, redesigned.',
    description: 'Rebuilt the consumer mobile app from scratch (React Native + Expo), serving 300+ clients with a WhatsApp-grade support chat. Grew an internal product suite used daily by operations and marketing. Now building Vivla’s first agentic AI features with Mastra, Vercel AI SDK and Langfuse.',
    year: '2025 — now',
    role: 'AI Product Engineer',
    bg: '#0A1628',
    fg: '#FFFFFF',
    accent: '#5AC8FA',
    href: 'https://vivla.com',
  },
];

const ventureProjects = [
  {
    name: 'Buildylab',
    tagline: 'AI working inside real businesses.',
    description: 'My AI studio. Audits, implementations and training for companies that want AI running in their operations, not in a slide deck. If you want to build something with me, this is the front door.',
    year: '2026 — now',
    role: 'Founder',
    bg: '#111113',
    fg: '#F5F5F7',
    accent: '#FFD60A',
    href: 'https://buildylab.com',
  },
  {
    name: 'Pampa Boats',
    tagline: 'Boat rentals on the Catalan coast.',
    description: 'A two-boat rental business in Cambrils that I run with my partner. Booking system, marketing site, finance dashboards. Real boats, real customers, real cash flow.',
    year: '2024 — now',
    role: 'Co-founder · Tech',
    bg: '#0EA5E9',
    fg: '#FFFFFF',
    accent: '#FFE066',
    href: 'https://pampaboats.com',
  },
];

const sideProjects = [
  {
    name: 'Flipr',
    year: '2025',
    detail: 'Deal-hunting platform — used motorcycles, cars from Germany to Spain, last-minute rentals. Built ~90% with AI agents.',
    href: 'https://flipr.jferreiros.com',
  },
  {
    name: 'Setalu',
    year: '2024',
    detail: '3D-printed lamp business. AI content pipelines for product photography and marketing across Instagram and Etsy.',
    href: '',
  },
  {
    name: 'Argenpats',
    year: '2024',
    detail: 'Map-driven directory + community for Argentinian-owned businesses abroad. Next.js · Mapbox · Chrome extension.',
    href: 'https://argenpats.com',
  },
];

const timeline = [
  { year: '2026', title: 'AI Product Engineer', org: 'Vivla', detail: 'Agentic AI features — Mastra · Vercel AI SDK · Langfuse. AI-native workflow with Claude Code, Cursor and Conductor.' },
  { year: '2025', title: 'Full Stack Developer AI', org: 'Vivla', detail: 'Consumer mobile app from scratch (React Native + Expo, 300+ clients) and an internal product suite for operations and marketing.' },
  { year: '2024', title: 'Full-stack developer', org: 'Meetoptics', detail: 'Marketplace of optical products for scientists. Vue.js · Node.js · AWS.' },
  { year: '2021', title: 'Full-stack developer', org: 'Emailing Network', detail: 'Systems behind 5M+ marketing emails a day. React · TypeScript · Symfony · AWS · Docker · K8s.' },
  { year: '2018', title: 'Web designer', org: 'Dixson Marketing · Freelance', detail: 'Sites and branding for clients.' },
  { year: '2012', title: 'First website, age 16', org: 'Self-taught', detail: 'HTML, CSS and a lot of curiosity. Never stopped building since.' },
];

const socials = [
  { label: 'GitHub', href: 'https://github.com/jferreiros' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/joaquin-ferreiros' },
  { label: 'X / Twitter', href: 'https://twitter.com/jferreiros' },
];
---

<Layout title="Joaquín Ferreiros — AI Product Engineer & Founder" singlePage={true}>
  <IdentityOrb />
  <nav class="topnav">
    <a href="#top" class="topnav-logo">Joaquín Ferreiros</a>
    <div class="topnav-links">
      <a href="#engineer">AI Product Engineer</a>
      <a href="#founder">Founder</a>
      <a href="#contact">Contact</a>
      <span class="topnav-sep" aria-hidden="true"></span>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="topnav-social">{s.label === 'X / Twitter' ? 'X' : s.label}</a>
      ))}
    </div>
  </nav>

  <section id="top" class="hero" data-orb-tint="rainbow">
    <HeroCanvas />
    <span class="eyebrow reveal">✦ Available for select projects · 2026</span>
    <h1 class="hero-title">
      <span class="reveal">Joaquín</span>
      <span class="reveal hero-accent">Ferreiros.</span>
    </h1>
    <p class="hero-sub reveal">
      AI Product Engineer in Barcelona. By day I ship agentic product at
      <a href="https://vivla.com">Vivla</a>; the rest of the time I build my own
      ventures — software and beyond.
    </p>
    <div class="hero-actions reveal">
      <a href="#engineer" class="button primary">AI Product Engineer →</a>
      <a href="#founder" class="button secondary">The founder →</a>
    </div>
    <div class="scroll-hint">Scroll</div>
  </section>

  <section id="about" class="now-section" data-orb-tint="sky">
    <div class="now-inner">
      <span class="section-num reveal">01 / Now</span>
      <h2 class="now-title">
        <span class="reveal">Two sides,</span>
        <span class="reveal now-strong">one builder.</span>
      </h2>
      <div class="now-body reveal">
        <p>
          By trade I'm an <strong>AI Product Engineer</strong>: at <strong>Vivla</strong> I own features end to end — talking to users, designing the UX, shipping to production — and right now I'm building the company's first agentic AI features.
        </p>
        <p>
          By nature I'm a <strong>founder</strong>: I run <strong>Pampa Boats</strong> with my partner, build products like <strong>Flipr</strong>, and through <strong>Buildylab</strong> I help companies put AI to work in their operations.
        </p>
      </div>
    </div>
  </section>

  <WorkSection
    projects={engineerProjects}
    id="engineer"
    num="02 / AI Product Engineer"
    title="Where I work."
  />

  <section class="experience" data-orb-tint="mint">
    <div class="experience-inner">
      <span class="section-num reveal">03 / Trail</span>
      <h2 class="experience-h2 reveal">Where I've been.</h2>
      <ol class="timeline">
        {timeline.map((t) => (
          <li class="timeline-item reveal">
            <span class="timeline-year">{t.year}</span>
            <div class="timeline-body">
              <span class="timeline-title">{t.title}</span>
              <span class="timeline-org">{t.org}</span>
              <span class="timeline-detail">{t.detail}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="stack" data-orb-tint="purple">
    <div class="stack-inner">
      <span class="section-num reveal">04 / Stack</span>
      <h2 class="stack-h2 reveal">Tools I reach for.</h2>
      <div class="stack-grid">
        <div class="stack-col reveal">
          <h4>AI & Agents</h4>
          <ul>
            <li>Mastra · Vercel AI SDK</li>
            <li>Langfuse</li>
            <li>OpenAI · Anthropic APIs</li>
            <li>Claude Code · Cursor · Conductor</li>
          </ul>
        </div>
        <div class="stack-col reveal">
          <h4>Frontend</h4>
          <ul>
            <li>React · React Native · Astro</li>
            <li>TanStack Router · Query</li>
            <li>Tailwind CSS</li>
            <li>TypeScript</li>
          </ul>
        </div>
        <div class="stack-col reveal">
          <h4>Backend</h4>
          <ul>
            <li>Node · Hono · NestJS</li>
            <li>PHP · Symfony</li>
            <li>Postgres · Supabase · Mongo</li>
            <li>Drizzle · Prisma</li>
          </ul>
        </div>
        <div class="stack-col reveal">
          <h4>Infra</h4>
          <ul>
            <li>AWS · Vercel · Coolify</li>
            <li>Docker · Kubernetes</li>
            <li>Cloudflare</li>
            <li>GitHub Actions</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <WorkSection
    projects={ventureProjects}
    id="founder"
    num="05 / The founder"
    title="What I'm building."
    showToggle={false}
  />

  <section class="experience side-projects" data-orb-tint="mint">
    <div class="experience-inner">
      <span class="section-num reveal">06 / Side quests</span>
      <h2 class="experience-h2 reveal">Always something on the boil.</h2>
      <ol class="timeline">
        {sideProjects.map((p) => (
          <li class="timeline-item reveal">
            <span class="timeline-year">{p.year}</span>
            <div class="timeline-body">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener" class="timeline-title side-link">{p.name} →</a>
              ) : (
                <span class="timeline-title">{p.name}</span>
              )}
              <span class="timeline-detail">{p.detail}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contact" class="contact" data-orb-tint="orange" data-orb-dark="true">
    <div class="contact-inner">
      <span class="section-num reveal">07 / Get in touch</span>
      <h2 class="contact-h2">
        <span class="reveal">Got a project</span>
        <span class="reveal contact-accent">worth shipping?</span>
      </h2>
      <p class="contact-sub reveal">
        Want AI working in your business? That's <a href="https://buildylab.com" class="contact-inline-link">Buildylab</a>.
        Want me on your team? Email is the fastest path.
      </p>
      <a href="mailto:hi@jferreiros.com" class="contact-cta reveal">hi@jferreiros.com →</a>
      <div class="contact-links reveal">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
        ))}
        <a href="https://buildylab.com" target="_blank" rel="noopener">Buildylab</a>
      </div>
    </div>
    <footer class="bottom-footer">
      <span>© 2026 Joaquín Ferreiros</span>
      <span>Made in Barcelona, with care.</span>
    </footer>
  </section>
</Layout>

<style>
  @keyframes reveal-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal {
    opacity: 1;
  }

  @supports (animation-timeline: view()) {
    .reveal {
      opacity: 0;
      animation: reveal-in linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 30%;
    }
  }

  .topnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    backdrop-filter: saturate(180%) blur(20px);
    background: rgba(251, 251, 253, 0.72);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .topnav-logo {
    color: var(--fg);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .topnav-logo:hover { opacity: 0.7; }

  .topnav-links {
    display: flex;
    gap: 2rem;
  }

  .topnav-links a {
    color: var(--fg-soft);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .topnav-links a:hover {
    color: var(--fg);
    opacity: 1;
  }

  .topnav-sep {
    width: 1px;
    height: 1rem;
    background: var(--hairline);
    align-self: center;
  }

  .topnav-social {
    font-family: var(--font-mono);
    font-size: 0.8125rem !important;
  }

  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 8rem 2rem 4rem;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    background: var(--bg);
    overflow: hidden;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-soft);
    letter-spacing: 0;
    margin-bottom: 2.5rem;
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    display: inline-block;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
  }

  .hero-title {
    font-size: clamp(3.5rem, 14vw, 14rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.92;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--brand-orange) 0%, var(--brand-purple) 60%, var(--brand-blue) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 38rem;
    margin-bottom: 2.5rem;
    letter-spacing: -0.015em;
  }

  .hero-sub a {
    color: var(--fg);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: bob 2.4s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); opacity: 0.7; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  .section-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .now-section {
    padding: 8rem 2rem;
    background: var(--bg);
  }

  .now-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .now-title {
    font-size: clamp(2.5rem, 6.5vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.02;
    margin: 0 0 3rem;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .now-strong {
    color: var(--fg);
    max-width: 24ch;
  }

  .now-body {
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 52rem;
  }

  .now-body strong {
    color: var(--fg);
    font-weight: 600;
  }

  .work-header {
    padding: 6rem 2rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .work-h2 {
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .project {
    background: var(--p-bg);
    color: var(--p-fg);
    padding: 7rem 2rem 8rem;
    position: relative;
    overflow: hidden;
  }

  .project-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .project-meta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--p-fg) 70%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .project-num { font-weight: 600; }

  .project-name {
    font-size: clamp(3rem, 11vw, 11rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.92;
    color: var(--p-fg);
    margin: 0 0 0.5rem;
  }

  .project-tagline {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--p-accent);
    max-width: 28ch;
    margin-bottom: 2rem;
  }

  .project-desc {
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--p-fg) 88%, transparent);
    max-width: 44rem;
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--p-fg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    width: fit-content;
    margin-bottom: 4rem;
  }

  .project-frame {
    margin-top: 2rem;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 24px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--p-fg) 8%, transparent), color-mix(in srgb, var(--p-fg) 2%, transparent));
    border: 1px solid color-mix(in srgb, var(--p-fg) 18%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--p-fg) 12%, transparent) inset,
      0 30px 80px color-mix(in srgb, var(--p-fg) 14%, transparent),
      0 0 0 1px color-mix(in srgb, var(--p-fg) 5%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .project-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top right, color-mix(in srgb, var(--p-accent) 40%, transparent), transparent 60%);
    opacity: 0.6;
  }

  .project-frame-inner {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--p-fg) 60%, transparent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-frame-mark {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--p-fg) 18%, transparent);
    text-transform: none;
  }

  .experience {
    padding: 8rem 2rem;
    background: var(--surface);
  }

  .experience-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .experience-h2 {
    font-size: clamp(2.5rem, 6.5vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 4rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--hairline);
    align-items: start;
  }

  .timeline-item:last-child { border-bottom: 1px solid var(--hairline); }

  .timeline-year {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    letter-spacing: 0;
    padding-top: 0.4rem;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .timeline-org {
    font-size: 1rem;
    color: var(--fg-soft);
    font-weight: 500;
  }

  .timeline-detail {
    font-size: 0.9375rem;
    color: var(--muted);
    margin-top: 0.25rem;
    line-height: 1.5;
  }

  .side-projects {
    background: var(--bg);
  }

  .side-link {
    width: fit-content;
  }

  .side-link:hover {
    color: var(--brand-orange);
    opacity: 1;
  }

  .stack {
    padding: 8rem 2rem;
    background: var(--bg);
  }

  .stack-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .stack-h2 {
    font-size: clamp(2.5rem, 6.5vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 4rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 3rem;
  }

  .stack-col h4 {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--muted);
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .stack-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .stack-col li {
    font-size: 1.0625rem;
    color: var(--fg);
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  .contact {
    background: #1D1D1F;
    color: #F5F5F7;
    padding: 10rem 2rem 3rem;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .contact .section-num { color: rgba(245, 245, 247, 0.5); }

  .contact-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .contact-h2 {
    font-size: clamp(3rem, 11vw, 12rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.92;
    color: rgba(245, 245, 247, 0.4);
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  .contact-accent {
    background: linear-gradient(135deg, #FF5C28 0%, #FF375F 50%, #7B2BFF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .contact-sub {
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    color: rgba(245, 245, 247, 0.65);
    max-width: 36rem;
    margin-bottom: 3rem;
    letter-spacing: -0.01em;
  }

  .contact-inline-link {
    color: #F5F5F7;
    border-bottom: 1px solid rgba(245, 245, 247, 0.4);
    padding-bottom: 1px;
  }

  .contact-inline-link:hover {
    color: var(--brand-orange);
    border-color: var(--brand-orange);
    opacity: 1;
  }

