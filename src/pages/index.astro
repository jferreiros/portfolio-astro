---
import Layout from '../layouts/Layout.astro';
import EraSection from '../components/eras/EraSection.astro';
---

<Layout title="Joaquín Ferreiros — Time Machine" singlePage={true}>
  <EraSection era="2024-2026" className="era-now">
    <div class="now-stage">
      <span class="now-meta">↳ now · 2024–2026 · Barcelona</span>
      <h1 class="now-h1">
        Joaquín
        <em>Ferreiros</em>
        builds things
        <em>on the&nbsp;web.</em>
      </h1>
      <p class="now-sub">
        Full-Stack en Meetoptics. De noche, side projects con IA — flipr, orbit, taskify, pampa boats.
        Empecé a hacer sitios cuando todavía existían los <code>&lt;marquee&gt;</code>. Bajá para verlo.
      </p>
      <div class="now-actions">
        <a href="/contact" class="now-cta">Hablemos →</a>
        <span class="now-hint">↓ scrolleá para rebobinar</span>
      </div>
    </div>
  </EraSection>

  <EraSection era="2021-2024" className="era-recent">
    <div class="stub-stage">
      <span class="stub-year">2021 — 2024</span>
      <h2 class="stub-title">Emailing Network</h2>
      <p class="stub-role">Full-Stack · React · TypeScript · Node · AWS · Docker · K8s</p>
      <p class="stub-note">Tres años full-stack: del front en React+TS al backend en Symfony + Node, pipelines en Airflow, CI/CD en Bitbucket, y mucho Postgres/Redshift. Esta es la era estética que tenía mi portfolio anterior — dark + amarillo huevo.</p>
    </div>
  </EraSection>

  <EraSection era="2018-2021" className="era-glass">
    <div class="stub-stage">
      <span class="stub-year">2018 — 2021</span>
      <h2 class="stub-title">Dixson Marketing · Freelance Web Designer</h2>
      <p class="stub-role">Sitios y branding para clientes — Photoshop, WordPress, primero Bootstrap, después Tailwind.</p>
      <p class="stub-note">El glassmorphism era nuevo, el neumorphism duró un mes, y los blobs flotantes eran casi obligatorios. Acá empecé a entender que el código y el diseño eran el mismo trabajo.</p>
    </div>
  </EraSection>

  <EraSection era="2017" className="era-material">
    <div class="stub-stage">
      <span class="stub-year">2017</span>
      <h2 class="stub-title">Centro ERI · Administrative</h2>
      <p class="stub-role">Pre-código. Spreadsheets, atención al cliente, gestión.</p>
      <p class="stub-note">Material Design 2 era la cosa. Hice mi primer sitio en HTML+CSS este año, mirando tutoriales en YouTube de noche.</p>
    </div>
  </EraSection>

  <EraSection era="2014" className="era-flat">
    <div class="stub-stage">
      <span class="stub-year">2014</span>
      <h2 class="stub-title">Cambridge B2 · último año del colegio</h2>
      <p class="stub-role">Verbo Divino · Argentina</p>
      <p class="stub-note">Bootstrap 3 dominaba la web. Lato Ultralight enorme, botones planos, parallax de montañas. Yo tenía 18 y todavía no sabía que iba a programar.</p>
    </div>
  </EraSection>

  <EraSection era="2008-2013" className="era-geocities">
    <div class="geo-stage">
      <marquee class="geo-marquee" scrollamount="6">
        ★ Welcome to Joaquín's homepage! ★ Site under construction since 2008 ★ Best viewed at 1024×768 ★ Add me to your favorites! ★
      </marquee>
      <div class="geo-frame">
        <h2 class="geo-h2">Welcome to my homepage!!!</h2>
        <p class="geo-greet">
          Hi! My name is <b>Joaquín</b>. I go to <u>Verbo Divino</u> in Argentina.
          This is my super cool homepage. I made it <i>all by myself</i>!!
        </p>
        <div class="geo-aboutme">
          <h3 class="geo-h3">About Me</h3>
          <ul class="geo-list">
            <li>★ I like soccer (Boca!!)</li>
            <li>★ My favorite band is Soda Stereo</li>
            <li>★ I want to be an architect when I grow up</li>
            <li>★ Or maybe make video games</li>
          </ul>
        </div>
        <a href="#" class="geo-button">Sign my guestbook!</a>
        <div class="geo-counter">
          <span class="geo-counter-label">Visitors:</span>
          <span class="geo-counter-num">00001337</span>
        </div>
        <div class="geo-construction">
          <span class="geo-blink">🔧 UNDER CONSTRUCTION 🔧</span>
        </div>
        <p class="geo-footer">
          © Joaquín 2008 — Best viewed in <b>Internet Explorer 6</b><br/>
          This site is part of the <u>WebRing</u>: [ &lt;&lt; Prev ] [ Random ] [ Next &gt;&gt; ]
        </p>
      </div>
    </div>
  </EraSection>
</Layout>

<style>
  .now-stage {
    max-width: 72rem;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .now-meta {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .now-h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    padding: 0;
    color: var(--fg);
  }

  .now-h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .now-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.55;
    max-width: 42rem;
    color: var(--fg);
  }

  .now-sub code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    background: rgba(10, 10, 10, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .now-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .now-cta {
    display: inline-block;
    padding: 0.9rem 1.5rem;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 999px;
    transition: transform 0.2s var(--easing), background 0.2s var(--easing);
  }

  .now-cta:hover {
    transform: translateY(-2px);
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  .now-hint {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .stub-stage {
    max-width: 56rem;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .stub-year {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .stub-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: var(--fg);
    margin: 0;
  }

  .stub-role {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 1.05rem;
    margin: 0;
  }

  .stub-note {
    font-family: var(--font-body);
    color: var(--fg);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 38rem;
    opacity: 0.85;
  }

  .era-glass .stub-title { letter-spacing: -0.02em; font-weight: 700; }
  .era-glass .stub-stage {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius);
    padding: 3rem;
    box-shadow: var(--shadow-mid);
  }

  .era-material .stub-stage {
    background: #ffffff;
    padding: 3rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow-mid);
  }
  .era-material .stub-title { font-weight: 300; letter-spacing: -0.5px; }
  .era-material .stub-role { text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.85rem; font-weight: 500; }

  .era-flat .stub-stage { text-align: center; align-items: center; }
  .era-flat .stub-title { font-weight: 100; letter-spacing: -1px; font-size: clamp(2.5rem, 7vw, 5rem); }
  .era-flat .stub-role {
    color: var(--bg);
    background: var(--accent);
    padding: 0.5rem 1.25rem;
    display: inline-block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: var(--shadow-mid);
  }

  .geo-stage {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--fg);
  }

  .geo-marquee {
    display: block;
    background: linear-gradient(to bottom, #FFD700 0%, #FF8C00 100%);
    color: #000;
    font-family: 'Trebuchet MS', sans-serif;
    font-weight: bold;
    padding: 6px;
    border-top: 2px ridge #FFF;
    border-bottom: 2px ridge #888;
    margin-bottom: 16px;
  }

  .geo-frame {
    background: #ffffff;
    border: 2px ridge #888;
    padding: 24px;
    box-shadow: 4px 4px 0 #555;
  }

  .geo-h2 {
    font-family: 'Comic Sans MS', cursive;
    font-size: 36px;
    color: #FF00FF;
    text-align: center;
    text-shadow: 1px 1px 0 #fff, 2px 2px 0 #999;
    margin: 0 0 16px;
    padding: 0;
  }

  .geo-h3 {
    font-family: 'Trebuchet MS', sans-serif;
    color: var(--accent);
    font-size: 18px;
    border-bottom: 2px solid var(--accent);
    margin: 16px 0 8px;
    padding: 0 0 4px;
  }

  .geo-greet {
    font-family: 'Times New Roman', Times, serif;
    font-size: 14px;
    line-height: 1.5;
    color: #000;
    margin-bottom: 16px;
  }

  .geo-aboutme {
    background: #FFFFCC;
    border: 1px solid #999;
    padding: 8px 16px;
    margin-bottom: 16px;
  }

  .geo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    color: #000;
    font-family: 'Comic Sans MS', cursive;
    font-size: 13px;
    line-height: 1.7;
  }

  .geo-button {
    display: inline-block;
    background: linear-gradient(to bottom, #7FB2FF 0%, #3B7FE8 50%, #1B4FA8 100%);
    color: #fff !important;
    font-family: 'Trebuchet MS', sans-serif;
    font-weight: bold;
    text-decoration: none;
    padding: 8px 20px;
    border: 1px solid #0A2A5A;
    border-top-color: #5A8FE0;
    border-radius: 6px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), inset 0 -1px 0 rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.4);
    text-shadow: 0 -1px 0 rgba(0,0,0,0.3);
    margin-right: 16px;
  }

  .geo-button:hover {
    background: linear-gradient(to bottom, #9FC7FF 0%, #5A9FF0 50%, #3B7FE8 100%);
    text-decoration: none !important;
  }

  .geo-counter {
    display: inline-block;
    background: #000;
    color: #00FF00;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    padding: 4px 8px;
    border: 2px inset #888;
    margin-top: 8px;
  }

  .geo-counter-label { color: #fff; margin-right: 6px; }
  .geo-counter-num { letter-spacing: 2px; }

  .geo-construction {
    text-align: center;
    margin: 16px 0;
  }

  .geo-blink {
    font-family: 'Comic Sans MS', cursive;
    color: #CC0000;
    font-weight: bold;
    font-size: 14px;
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    to { visibility: hidden; }
  }

  .geo-footer {
    font-family: 'Times New Roman', Times, serif;
    font-size: 11px;
    color: #555;
    text-align: center;
    margin-top: 16px;
    border-top: 1px dashed #999;
    padding-top: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .geo-marquee { animation: none; }
    .geo-blink { animation: none; }
  }
</style>
