---
interface Project {
  name: string;
  tagline: string;
  description: string;
  year: string;
  role: string;
  bg: string;
  fg: string;
  accent: string;
  href: string;
}

interface Props {
  projects: Project[];
  id?: string;
  num?: string;
  title?: string;
  showToggle?: boolean;
}

const {
  projects,
  id = 'work',
  num = '02 / Selected work',
  title = "A few things I've built.",
  showToggle = true,
} = Astro.props;
---

<script is:inline>
  (function () {
    try {
      const stored = localStorage.getItem('work.mode');
      const mode = stored === 'list' || stored === 'cinematic' ? stored : 'cinematic';
      document.documentElement.setAttribute('data-work-mode', mode);
    } catch (_) {
      document.documentElement.setAttribute('data-work-mode', 'cinematic');
    }
  })();
</script>

<section id={id} class="work-header">
  <div class="work-header-inner">
    <div class="work-heading-row">
      <div>
        <span class="section-num reveal">{num}</span>
        <h2 class="work-h2 reveal">{title}</h2>
      </div>

      {showToggle && <div
        class="work-toggle reveal"
        role="radiogroup"
        aria-label="Selected work view mode"
      >
        <button
          type="button"
          class="work-toggle-btn"
          data-mode="cinematic"
          role="radio"
          aria-checked="true"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2.5" y="2.5" width="6" height="6" rx="1" />
            <rect x="11.5" y="2.5" width="6" height="6" rx="1" />
            <rect x="2.5" y="11.5" width="6" height="6" rx="1" />
            <rect x="11.5" y="11.5" width="6" height="6" rx="1" />
          </svg>
          <span>Cinematic</span>
        </button>
        <button
          type="button"
          class="work-toggle-btn"
          data-mode="list"
          role="radio"
          aria-checked="false"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="6" y1="5" x2="17" y2="5" />
            <line x1="6" y1="10" x2="17" y2="10" />
            <line x1="6" y1="15" x2="17" y2="15" />
            <circle cx="3.25" cy="5" r="0.9" fill="currentColor" stroke="none" />
            <circle cx="3.25" cy="10" r="0.9" fill="currentColor" stroke="none" />
            <circle cx="3.25" cy="15" r="0.9" fill="currentColor" stroke="none" />
          </svg>
          <span>List</span>
        </button>
        <span class="work-toggle-thumb" aria-hidden="true"></span>
      </div>}
    </div>
  </div>
</section>

<div class="work-cinematic">
  {projects.map((p, i) => (
    <section
      class="project"
      style={`--p-bg: ${p.bg}; --p-fg: ${p.fg}; --p-accent: ${p.accent};`}
    >
      <div class="project-inner">
        <div class="project-meta reveal">
          <span class="project-num">0{i + 1}</span>
          <span class="project-year">{p.year}</span>
          <span class="project-role">{p.role}</span>
        </div>
        <h3 class="project-name reveal">{p.name}</h3>
        <p class="project-tagline reveal">{p.tagline}</p>
        <p class="project-desc reveal">{p.description}</p>
        {p.href !== '#' && (
          <a class="project-link reveal" href={p.href} target="_blank" rel="noopener noreferrer">
            Visit {p.name} →
          </a>
        )}
        <div class="project-frame reveal" aria-hidden="true">
          <div class="project-frame-inner">
            <span class="project-frame-mark">{p.name}</span>
          </div>
        </div>
      </div>
    </section>
  ))}
</div>

<section class="work-list">
  <div class="work-list-inner">
    <ol class="work-list-rows">
      {projects.map((p, i) => {
        const isExternal = p.href !== '#';
        const Tag = isExternal ? 'a' : 'div';
        const props = isExternal
          ? { href: p.href, target: '_blank', rel: 'noopener noreferrer' }
          : {};
        return (
          <li class="work-list-row reveal">
            <Tag class="work-list-link" {...props}>
              <span class="work-list-year">{p.year}</span>
              <span class="work-list-name">{p.name}</span>
              <span class="work-list-tagline">{p.tagline}</span>
              <span class="work-list-role">{p.role}</span>
              <span
                class="work-list-dot"
                style={`background: ${p.accent}; box-shadow: 0 0 0 1px color-mix(in srgb, ${p.fg} 12%, transparent);`}
                aria-hidden="true"
              ></span>
            </Tag>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  import { sfx } from '../lib/sfx';

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.work-toggle-btn');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function syncButtons(mode: string) {
    buttons.forEach((btn) => {
      const active = btn.dataset.mode === mode;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    const toggle = document.querySelector<HTMLElement>('.work-toggle');
    if (toggle) toggle.dataset.mode = mode;
  }

  function applyMode(mode: 'cinematic' | 'list') {
    root.setAttribute('data-work-mode', mode);
    try {
      localStorage.setItem('work.mode', mode);
    } catch (_) {}
    syncButtons(mode);
    document.dispatchEvent(
      new CustomEvent('work:mode-change', { detail: { mode } }),
    );
  }

  function setMode(mode: 'cinematic' | 'list') {
    if (root.getAttribute('data-work-mode') === mode) return;

    try {
      sfx.switch();
    } catch (_) {}

    const supportsVT =
      typeof (document as any).startViewTransition === 'function' && !reduceMotion;

    if (supportsVT) {
      (document as any).startViewTransition(() => applyMode(mode));
    } else {
      applyMode(mode);
    }
  }

  syncButtons(root.getAttribute('data-work-mode') || 'cinematic');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode as 'cinematic' | 'list';
      if (mode) setMode(mode);
    });
  });
</script>

<style>
  html[data-work-mode='cinematic'] .work-list,
  html[data-work-mode='list'] .work-cinematic {
    display: none;
  }

  .work-cinematic,
  .work-list {
    view-transition-name: work-section;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-cinematic,
    .work-list {
      view-transition-name: none;
    }
  }

  .work-header {
    padding: 6rem 2rem 3rem;
  }

  .work-header-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .work-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .work-h2 {
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .work-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    isolation: isolate;
  }

  .work-toggle-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    border-radius: 999px;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .work-toggle-btn svg {
    opacity: 0.85;
    transition: transform 200ms ease;
  }

  .work-toggle-btn:hover { color: var(--fg-soft); }

  .work-toggle-btn.is-active {
    color: var(--fg);
  }

  .work-toggle-btn.is-active svg {
    transform: scale(1.04);
    opacity: 1;
  }

  .work-toggle-thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    background: #ffffff;
    border-radius: 999px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 4px 12px rgba(0, 0, 0, 0.05),
      0 0 0 1px rgba(0, 0, 0, 0.03);
    transition: transform 260ms cubic-bezier(0.32, 0.72, 0.2, 1);
    z-index: 0;
  }

  .work-toggle[data-mode='list'] .work-toggle-thumb {
    transform: translateX(100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-toggle-thumb,
    .work-toggle-btn,
    .work-toggle-btn svg {
      transition: none;
    }
  }

  .project {
    background: var(--p-bg);
    color: var(--p-fg);
    padding: 7rem 2rem 8rem;
    position: relative;
    overflow: hidden;
  }

  .project-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .project-meta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--p-fg) 70%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .project-num { font-weight: 600; }

  .project-name {
    font-size: clamp(3rem, 11vw, 11rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.92;
    color: var(--p-fg);
    margin: 0 0 0.5rem;
  }

  .project-tagline {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--p-accent);
    max-width: 28ch;
    margin-bottom: 2rem;
  }

  .project-desc {
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--p-fg) 88%, transparent);
    max-width: 44rem;
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--p-fg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    width: fit-content;
    margin-bottom: 4rem;
  }

  .project-frame {
    margin-top: 2rem;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 24px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--p-fg) 8%, transparent), color-mix(in srgb, var(--p-fg) 2%, transparent));
    border: 1px solid color-mix(in srgb, var(--p-fg) 18%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--p-fg) 12%, transparent) inset,
      0 30px 80px color-mix(in srgb, var(--p-fg) 14%, transparent),
      0 0 0 1px color-mix(in srgb, var(--p-fg) 5%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .project-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top right, color-mix(in srgb, var(--p-accent) 40%, transparent), transparent 60%);
    opacity: 0.6;
  }

  .project-frame-inner {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--p-fg) 60%, transparent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-frame-mark {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--p-fg) 18%, transparent);
    text-transform: none;
  }

  .work-list {
    padding: 2rem 2rem 8rem;
    background: var(--bg);
  }

  .work-list-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .work-list-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .work-list-row {
    border-top: 1px solid var(--hairline);
  }

  .work-list-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .work-list-link {
    display: grid;
    grid-template-columns: 100px minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 0.9fr) 16px;
    gap: 2rem;
    align-items: center;
    padding: 1.6rem 1rem;
    margin: 0 -1rem;
    border-radius: 14px;
    color: var(--fg);
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }

  .work-list-link:hover {
    background: var(--surface);
    opacity: 1;
  }

  .work-list-year {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: 0;
  }

  .work-list-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--fg);
    line-height: 1.1;
  }

  .work-list-tagline {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--muted);
    letter-spacing: -0.01em;
  }

  .work-list-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: right;
  }

  .work-list-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    justify-self: end;
    transition: transform 200ms ease;
  }

  .work-list-link:hover .work-list-dot {
    transform: scale(1.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-list-link,
    .work-list-dot {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .work-header { padding-left: 1.25rem; padding-right: 1.25rem; }
    .work-heading-row { align-items: flex-start; }
    .project { padding-left: 1.25rem; padding-right: 1.25rem; }
    .work-list { padding-left: 1.25rem; padding-right: 1.25rem; }

    .work-list-link {
      grid-template-columns: 1fr 16px;
      grid-auto-rows: auto;
      gap: 0.4rem 1rem;
      padding: 1.25rem 0.75rem;
      margin: 0 -0.75rem;
    }

    .work-list-year {
      grid-column: 1;
      grid-row: 1;
    }

    .work-list-name {
      grid-column: 1;
      grid-row: 2;
      font-size: 1.375rem;
    }

    .work-list-tagline {
      grid-column: 1;
      grid-row: 3;
      font-size: 0.9375rem;
    }

    .work-list-role {
      grid-column: 1;
      grid-row: 4;
      text-align: left;
      margin-top: 0.25rem;
    }

    .work-list-dot {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }
</style>
