---
interface Props {
  era: string;
  className?: string;
}
const { era, className = '' } = Astro.props;
---

<section data-era={era} class:list={['era-section', className]}>
  <slot />
</section>

<style>
  .era-section {
    min-height: 100svh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    box-sizing: border-box;
    position: relative;
  }
</style>
